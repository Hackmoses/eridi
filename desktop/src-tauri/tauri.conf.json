{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eridi",
  "version": "0.0.1",
  "identifier": "org.eridi.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eridi",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "minWidth": 420,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your lab's research memory",
    "longDescription": "Eridi indexes the files your lab already has, notices when protocols change, and records why things changed and whether they worked. Everything stays on your computer.",
    "copyright": "Eridi contributors, Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/eridi-engine"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/Hackmoses/eridi/releases/latest/download/latest.json"]
    }
  }
}
